# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/lanchonete_qr

# true em serviços gerenciados que exigem SSL (Render, Neon, Heroku, etc.)
# deixe em false / omitido para desenvolvimento local
DATABASE_SSL=false

PORT=3000

# Senha compartilhada da equipe para acessar /admin e /caixa.
# Sem ela definida, o login fica bloqueado (erro 500 ao tentar entrar).
ADMIN_PASSWORD=troque-esta-senha

# Limite do body JSON em bytes (padrão 131072 = 128 KB)
# MAX_BODY_BYTES=131072

# Cache do cardápio público em ms (padrão 30000)
# CARDAPIO_CACHE_TTL_MS=30000

# Em produção com SSL: valide o certificado (true) a menos que o provedor
# exija o contrário. Só defina false se souber o que está fazendo.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# production ativa cookie Secure e mensagens de erro genéricas
# NODE_ENV=production
