# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/lanchonete_qr

# true em serviços gerenciados que exigem SSL (Render, Neon, Heroku, etc.)
DATABASE_SSL=false

PORT=3000

# Senha usada no seed inicial dos usuários admin/cozinha/caixa
STAFF_SEED_PASSWORD=troque-esta-senha

# PIX estático (QR / copia-e-cola na mesa e no caixa)
# Chave: CPF (11 dígitos), CNPJ, e-mail, telefone (+5511...) ou chave aleatória
# Exemplos:
#   PIX_CHAVE=12345678901
#   PIX_CHAVE=123.456.789-01   (também funciona — normalizamos)
#   PIX_CHAVE=seu@email.com
#   PIX_CHAVE=+5511999999999
PIX_CHAVE=
PIX_NOME=LANCHONETE
PIX_CIDADE=SAO PAULO

# NODE_ENV=production
