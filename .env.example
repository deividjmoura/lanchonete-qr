# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/lanchonete_qr

# true em serviços gerenciados que exigem SSL (Render, Neon, Heroku, etc.)
DATABASE_SSL=false

PORT=3000

# Senha usada no seed inicial dos usuários admin/cozinha/caixa
STAFF_SEED_PASSWORD=troque-esta-senha

# PIX estático (QR / copia-e-cola na mesa e no caixa)
# Chave: CPF (11 dígitos), CNPJ, e-mail, telefone (+5511...) ou chave aleatória
# Exemplos:
#   PIX_CHAVE=12345678901
#   PIX_CHAVE=123.456.789-01   (também funciona — normalizamos)
#   PIX_CHAVE=seu@email.com
#   PIX_CHAVE=+5511999999999
PIX_CHAVE=
PIX_NOME=LANCHONETE
PIX_CIDADE=SAO PAULO

# NODE_ENV=production

# --- Gateway PagBank / PagSeguro (PIX dinâmico + confirmação automática) ---
# Token da API (Bearer). Sandbox: https://sandbox.api.pagseguro.com
# PAGBANK_TOKEN=
# PAGBANK_SANDBOX=1
# URL pública HTTPS do servidor (obrigatória para webhook)
# PUBLIC_BASE_URL=https://seu-dominio.com
# CPF/CNPJ padrão do pagador quando o cliente não informa (só dígitos)
# PAGBANK_DEFAULT_TAX_ID=00000000000
# PAGBANK_DEFAULT_EMAIL=cliente@lanchonete.local
